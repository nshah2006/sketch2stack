# Copy to .env and fill in. .env is gitignored.

# Which chat LLM turns a spoken/typed request into a build: openai (default) or nvidia.
# Either way, no key means the offline rule parser handles it.
# Leave LLM_PROVIDER unset to try Nemotron first and fall back to OpenAI.
# Set it to pin one provider (openai or nvidia) when you want to prove which answered.
# LLM_PROVIDER=

# OpenAI: the chat LLM above and the voice-to-text (whisper) always use this key.
OPENAI_API_KEY=your-openai-api-key-here
#OPENAI_MODEL=gpt-4o-mini

# NVIDIA Nemotron (OpenAI-compatible API). Free key from https://build.nvidia.com -
# pick a model, "Get API Key", it starts with nvapi-. Set LLM_PROVIDER=nvidia to use it.
# NVIDIA_MODEL must match an id listed on build.nvidia.com; the ones below are only guesses.
NVIDIA_API_KEY=your-nvidia-api-key-here
#NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
#NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Any other OpenAI-compatible endpoint: override the base url (no /chat/completions).
#LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Supabase block inventory (see DATABASE.md). Project ref: ykevkqzxuthubvbqkcld
# URL looks like https://<project-ref>.supabase.co  (no trailing slash)
SUPABASE_URL=https://ykevkqzxuthubvbqkcld.supabase.co
# The publishable / anon key (starts with sb_publishable_ or eyJ...). Safe to
# hold here, but it only reads what row-level security allows.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Hugging Face read token (GR00T base model is gated). Put the real one in .env, never here.
HF_TOKEN=your-hf-token-here
